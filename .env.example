# Copia este archivo como .env. El archivo .env nunca se sube a git ni llega al navegador.

# --- OpenAI (Eco) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- ElevenLabs (voces de los personajes) ---
ELEVENLABS_API_KEY=
# Modelo de voz: eleven_flash_v2_5 es el más rápido (español e inglés)
ELEVENLABS_MODEL=eleven_flash_v2_5
# ID de voz de cada personaje (voces gratuitas predeterminadas de ElevenLabs)
ELEVENLABS_VOICE_LUMA=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_VOICE_PIPO=cgSgspJ2msm6clMCkdW9
ELEVENLABS_VOICE_NIX=cjVigY5qzO86Huf0OWal

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
# Clave pública (publishable / anon): la usan el dashboard y la app móvil
SUPABASE_ANON_KEY=
# Clave secreta (secret / service_role): SOLO el servidor (simulador). Nunca en la app ni en el dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=3000
# 127.0.0.1 = solo esta computadora (el emulador de Android entra por 10.0.2.2).
# Para un celular real en la misma red Wi-Fi usa 0.0.0.0
HOST=127.0.0.1
# Misión de seed_demo.sql
MISSION_ID=a0000000-0000-4000-8000-000000000001
SIM_TICK_MS=3000
